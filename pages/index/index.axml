<view class="app">

  <text class="header-text">Search A Song</text>

  <ant-form-input
    maxLength="20"
    label="Artist"
    name="artist"
    placeholder="Ed Sheeran"
    required
    position="{{position}}"
    ref="handleRef"
  >
  </ant-form-input>

  <ant-form-input
    maxLength="20"
    label="Title"
    name="title"
    required
    position="{{position}}"
    ref="handleRef"
    placeholder="Perfect"
  >
  </ant-form-input>

  <ant-button type="default">Search</ant-button>


</view>