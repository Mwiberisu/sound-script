.app {
  background-color: teal;
  font-family: Cambria, Cochin, Georgia, Times, 'Times New Roman', serif;
  color: goldenrod;
  padding: 5%;
  display: flex;
  gap: 20px;
  flex-direction: column;

}

.header-text {
  font-size: xx-large;
  font-style: italic;
  font-weight: bolder;
  text-align: center;

}

.button {
  border-radius: 5px;
  background-color: rgb(226, 187, 87);
  color: teal;
}

.input {
  border-radius: 5px;
}